# APP_URL / APP_BASE_URL: Trusted public HTTPS URL where this app is hosted (used for password reset links)
APP_BASE_URL=""
APP_URL="http://localhost:3000"

# Cloud SQL Runtime Variables (injected automatically in Google Cloud)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Standard PostgreSQL Connection String (used on Render, Railway, Neon, etc.)
DATABASE_URL=""

# Session & Security Configuration
SESSION_SECRET="change-me-to-a-long-random-secret"
ADMIN_EMAIL="admin@scholarpress.edu"

# Razorpay Payment Gateway (INR) - Optional: Leave blank to run in Test/Sandbox Mode
# Obtain keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# PostgreSQL Connection Pool Limit (Recommended: 8-12 on Render Starter/Free)
PG_POOL_MAX="12"

# Storage Directory (fallback local/persistent disk storage when S3/R2 is not configured)
UPLOAD_STORAGE_DIR="./storage"

# Direct-to-Object-Storage Uploads (AWS S3, Cloudflare R2, Backblaze B2, or GCS S3-Compatible API)
# Leave blank to use server-managed local/chunked resumable storage with async WebP/AVIF thumbnails
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_CDN_URL=""

# Transactional Email (Gmail SMTP / Custom SMTP) for OTP Verification & Account Notices
# For Gmail: set SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_SECURE="true", SMTP_USER="your@gmail.com", SMTP_PASS="16-char-app-password"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional Server-Side AI Semantic Embeddings (Google Gemini Embedding API)
# Leave blank to run the built-in zero-cost local educational semantic + fuzzy + BM25 search engine
GEMINI_API_KEY=""

# Optional External Educational Video Discovery (YouTube Data API v3)
# Leave blank to search exclusively inside ScholarPress's verified catalog
YOUTUBE_API_KEY=""

