# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL Runtime Variables (injected automatically in Google Cloud)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Standard PostgreSQL Connection String (used on Render, Railway, Neon, etc.)
DATABASE_URL=""

# Session & Security Configuration
SESSION_SECRET="change-me-to-a-long-random-secret"
ADMIN_EMAIL="admin@scholarpress.edu"

# Razorpay Payment Gateway (INR) - Optional: Leave blank to run in Test/Sandbox Mode
# Obtain keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Storage Directory (for local/persistent volume object storage adapter)
UPLOAD_STORAGE_DIR="./storage"

# Transactional Email (Gmail SMTP / Custom SMTP) for Account Deletion & Block Notices
# For Gmail: set SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER="your@gmail.com", SMTP_PASS="16-char-app-password"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

